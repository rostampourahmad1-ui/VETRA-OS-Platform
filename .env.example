# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ─── Non-Owner Database Roles (VETRA-INFRA-01) ──────────────────────────────
# Application role (non-owner, RLS-enforced) — for API server runtime
DATABASE_APP_URL=postgresql://vetra_app:APP_PASSWORD@HOST:5432/DATABASE?sslmode=require
# Migration role (DDL-capable) — for running Drizzle migrations only
DATABASE_MIGRATION_URL=postgresql://vetra_migration:MIGRATION_PASSWORD@HOST:5432/DATABASE?sslmode=require
# Read-only role — for reporting/analytics
DATABASE_READONLY_URL=postgresql://vetra_readonly:READONLY_PASSWORD@HOST:5432/DATABASE?sslmode=require
# PgBouncer connection (transaction pooling) — use instead of direct PostgreSQL
DATABASE_PGBOUNCER_URL=postgresql://vetra_app:APP_PASSWORD@HOST:6432/DATABASE?sslmode=require

# Docker Compose: PostgreSQL admin password (required for docker compose up)
# Replace with a strong password before running docker compose up
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Docker Compose: Application non-owner role password
# Replace with a strong password before running docker compose up
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
# Docker Compose: Migration role password
# Replace with a strong password before running docker compose up
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION_PASSWORD
# Docker Compose: Read-only role password
# Replace with a strong password before running docker compose up
POSTGRES_READONLY_PASSWORD=CHANGE_ME_READONLY_PASSWORD

# Clerk authentication
# Get these from your Clerk dashboard: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Clerk Webhook (Svix) signing secret for user provisioning
# Set up a webhook in Clerk and add this secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# API server
PORT=5000
# Comma-separated browser origins permitted to send credentialed cross-origin requests.
# Leave empty when the web app and API are served from the same origin.
CORS_ALLOWED_ORIGINS=https://app.example.com

# OpenAI-compatible API
# Get your API key from: https://platform.openai.com
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
