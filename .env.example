# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# API server
PORT=5000

# OpenAI-compatible API
OPENAI_API_KEY=sk-replace_with_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
