# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_with_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_clerk_publishable_key

# API server
PORT=5000
# Comma-separated browser origins permitted to send credentialed cross-origin requests.
# Leave empty when the web app and API are served from the same origin.
CORS_ALLOWED_ORIGINS=https://app.example.com

# OpenAI-compatible API
OPENAI_API_KEY=sk-replace_with_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
