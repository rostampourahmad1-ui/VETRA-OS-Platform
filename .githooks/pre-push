#!/bin/sh
# VETRA OS policy: never push directly to 'main'.
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/heads/main)
			echo "ERROR: Direct push to 'main' is forbidden by policy."
			echo "Push a feature branch and open a Pull Request instead."
			exit 1
			;;
	esac
done
exit 0
