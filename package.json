{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"try { require('fs').unlinkSync('package-lock.json'); } catch(e) {} try { require('fs').unlinkSync('yarn.lock'); } catch(e) {}\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "vitest run",
    "db:migrate": "node scripts/run-migrations.mjs",
    "validate:final": "node scripts/final-validation.mjs"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "drizzle-orm": "catalog:"
  }
}
